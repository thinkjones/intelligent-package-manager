__screenshots__/

# TanStack Router generated route tree (regenerated by the dev/build plugin)
src/routeTree.gen.ts

# Wrangler-generated binding types (regenerated by `pnpm cf-types`)
worker-configuration.d.ts

# Secrets & local env — never commit
.dev.vars
.env*
!.env.tmpl
!.env.local.overrides
# Deploy-only credentials (cloud deploys). Generated deploy.env gitignored; template tracked.
deploy.env*
!deploy.env.tmpl
# wrangler.toml is GENERATED from wrangler.toml.tmpl by env-generate.sh; template tracked.
wrangler.toml
!wrangler.toml.tmpl

# Throwaway Phase 0 spike — kept local, never committed
spike/

# Local-only API keys — never commit
model_keys.md

# Git worktrees for isolated polecat feature work (local-only)
.worktrees/
worktrees/


# APM dependencies
apm_modules/

# Brainstorming visual companion
.superpowers/

# Extraction baseline harness output (local-only, date-stamped runs)
.pipeline/
pipeline-runs/


