#!/usr/bin/env bash
# ipm shim — runs a development build of this checkout: bin/ipm <command>.
# It (re)builds cli/bin/ipm whenever a Go source is newer than the binary,
# then replaces itself with it. ./install.sh installs ipm on PATH. ipm keeps its data
# in your user folders (IPM_HOME, IPM_CACHE_DIR), not in this checkout.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cli="$root/cli"
bin="$cli/bin/ipm"

if [[ ! -x $bin ]] || [[ -n $(find "$cli" -path "$cli/bin" -prune -o \( -name '*.go' -o -name go.mod -o -name go.sum \) -newer "$bin" -print -quit) ]]; then
  (cd "$cli" && go build -o bin/ipm ./cmd/ipm) >&2
fi

exec "$bin" "$@"
